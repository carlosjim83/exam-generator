# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# OAuth Configuration
# Set to 'true' to use mock OAuth (no real Google account needed, faster development)
# Set to 'false' to use real Google OAuth (requires valid Google Cloud credentials in backend)
# Default: false (use real OAuth)
NEXT_PUBLIC_USE_MOCK_OAUTH=false

# Data Fixtures (Only for Testing/Demos)
# Set to 'true' to use mock data (fixtures) instead of real API calls
# Set to 'false' to use real backend API (gracefully falls back for missing endpoints)
# Default: false (use real API)
# Note: API service automatically handles missing endpoints with graceful fallbacks
NEXT_PUBLIC_USE_FIXTURES=false
