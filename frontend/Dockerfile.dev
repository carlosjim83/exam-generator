# ================================
# Frontend Development Dockerfile
# ================================
# Hot reload enabled via Next.js dev server
FROM node:20-alpine

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Install development tools
RUN apk add --no-cache dumb-init libc6-compat

WORKDIR /app

# Copy workspace configuration (monorepo setup)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY frontend/package.json ./frontend/

# Install dependencies for frontend workspace
RUN pnpm install --frozen-lockfile --filter=exam-generator-frontend...

# Copy frontend source code
COPY frontend ./frontend

WORKDIR /app/frontend

# Expose port
EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start Next.js dev server with hot reload
CMD ["pnpm", "dev"]
