# Azure Infrastructure Configuration
# Generated: 2026-02-01

# Resource Group
RESOURCE_GROUP=exam-generator-rg
LOCATION=swedencentral

# Container Registry
ACR_NAME=examgeneratorcj
ACR_LOGIN_SERVER=examgeneratorcj.azurecr.io
