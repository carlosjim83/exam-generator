# Container Apps URLs
BACKEND_URL=https://exam-generator-backend.kindforest-d0a6102e.swedencentral.azurecontainerapps.io
FRONTEND_URL=https://exam-generator-frontend.kindforest-d0a6102e.swedencentral.azurecontainerapps.io

# Database
