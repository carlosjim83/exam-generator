# Test Environment Configuration
# This file is loaded by vitest before .env to override development settings

# Test Database - MUST be different from development database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/exam_generator_test

# Test-specific upload folder (uses temp directory)
UPLOAD_DIR=/tmp/exam-generator-test-uploads

# Redis (can use same as dev since it's just for queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (can use same keys as dev for tests)
JWT_SECRET=test-jwt-secret-key-2026
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Disable OAuth for tests
ENABLE_OAUTH_MOCK=true

# Disable Azure for tests (uses local storage)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=